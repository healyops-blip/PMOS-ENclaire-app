POMI_ENVIRONMENT=development
POMI_DATABASE_URL=sqlite:///./runtime/pomi.db
POMI_STORAGE_ROOT=./runtime/storage
POMI_SESSION_TTL_SECONDS=604800
POMI_AUTH_RATE_LIMIT_ATTEMPTS=5
POMI_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Local development uses an explicitly labelled synthetic OCR draft.
POMI_OCR_MODE=mock
POMI_QWEN_API_URL=
POMI_QWEN_API_KEY=
POMI_QWEN_MODEL=qwen3-vl
POMI_OCR_MAX_ATTEMPTS=3
POMI_OCR_LEASE_SECONDS=180
