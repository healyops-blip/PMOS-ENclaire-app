POMI_ENVIRONMENT=production
POMI_DATABASE_URL=sqlite:////var/lib/pomi/pomi.db
POMI_STORAGE_ROOT=/var/lib/pomi/storage
POMI_SQLITE_PATH=/var/lib/pomi/pomi.db
POMI_BACKUP_DIR=/var/backups/pomi
POMI_ALLOWED_HOSTS=api.healy1012-ops.top,localhost,127.0.0.1
POMI_SESSION_TTL_SECONDS=604800
POMI_ARGON2_TIME_COST=3
POMI_ARGON2_MEMORY_COST_KIB=65536
POMI_ARGON2_PARALLELISM=2
POMI_AUTH_RATE_LIMIT_ATTEMPTS=5
POMI_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
POMI_OCR_MODE=mock
POMI_QWEN_API_URL=
POMI_QWEN_API_KEY=
POMI_QWEN_MODEL=qwen3-vl
POMI_OCR_MAX_ATTEMPTS=3
POMI_OCR_LEASE_SECONDS=180
