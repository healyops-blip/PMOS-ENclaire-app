{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pomi.local/schemas/lab-draft.schema.json",
  "title": "LabDraft",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "hospital_name": {"type": ["string", "null"]},
    "sample_date": {"type": ["string", "null"], "format": "date"},
    "report_date": {"type": ["string", "null"], "format": "date"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_name", "raw_value"],
        "properties": {
          "item_name": {"type": "string", "minLength": 1},
          "item_code": {"type": ["string", "null"]},
          "raw_value": {"type": "string", "minLength": 1},
          "numeric_value": {"type": ["number", "null"]},
          "raw_unit": {"type": ["string", "null"]},
          "normalized_unit": {"type": ["string", "null"]},
          "reference_range_text": {"type": ["string", "null"]},
          "reference_low": {"type": ["number", "null"]},
          "reference_high": {"type": ["number", "null"]}
        }
      }
    }
  }
}
