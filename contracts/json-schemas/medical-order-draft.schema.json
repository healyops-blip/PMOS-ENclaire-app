{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pomi.local/schemas/medical-order-draft.schema.json",
  "title": "MedicalOrderDraft",
  "type": "object",
  "additionalProperties": false,
  "required": ["orders"],
  "properties": {
    "hospital_name": {"type": ["string", "null"]},
    "department_name": {"type": ["string", "null"]},
    "prescribed_at": {"type": ["string", "null"], "format": "date"},
    "orders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_text", "drug_name"],
        "properties": {
          "source_text": {"type": "string", "minLength": 1},
          "drug_name": {"type": "string", "minLength": 1},
          "normalized_drug_name": {"type": ["string", "null"]},
          "specification": {"type": ["string", "null"]},
          "dosage_text": {"type": ["string", "null"]},
          "dosage_value": {"type": ["number", "null"]},
          "dosage_unit": {"type": ["string", "null"]},
          "frequency": {"type": ["string", "null"]},
          "duration": {"type": ["string", "null"]},
          "route": {"type": ["string", "null"]},
          "instruction": {"type": ["string", "null"]}
        }
      }
    }
  }
}
